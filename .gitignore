# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the build output in the repo.
# The dist directory is generated by the build and contains main.js,
# manifest.json and styles.css.
dist
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Local development environment (vault path and other machine-specific values).
# The directory itself is tracked, only the local values are not.
_for-dev/.env
_for-dev/*.local
*.env.local
.env

