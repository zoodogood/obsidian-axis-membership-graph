{
	"name": "axis-membership-graph",
	"version": "1.0.0",
	"description": "Displays intermediate notes with membership markers-symbols",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"deploy": "node scripts/deploy.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/zoodogood/obsidian-axis-membership-graph.git"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"axis-membership-graph"
	],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"author": "zoodogood"
}
